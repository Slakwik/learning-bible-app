<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="textAppearanceHeadlineSmall">@style/ChurchHeading</item>
        <item name="textAppearanceTitleLarge">@style/ChurchHeading</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>
    <style name="ChurchHeading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/playfair</item>
        <item name="fontFamily">@font/playfair</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AppWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_return</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_leave</item>
    </style>
</resources>
